# Environment Configuration for BatchSaver
# Duplicate this file as .env for local development

# Node Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://batchsaver_user:batchsaver_pass@localhost:5432/batchsaver_db?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_NAME=batchsaver_db
DB_USER=batchsaver_user
DB_PASSWORD=batchsaver_pass

# Security & Auth
JWT_SECRET=super-secret-jwt-key-replace-in-production-batchsaver-2026
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000

# Process Parameters Defaults (Can override central config)
PARAM_VISCOSITY_TARGET=3200
PARAM_VISCOSITY_TOLERANCE=150
PARAM_MOISTURE_TARGET=38.0
PARAM_MOISTURE_TOLERANCE=1.5
PARAM_COLOUR_TARGET=62.0
PARAM_COLOUR_TOLERANCE=3.0
PARAM_TEMPERATURE_TARGET=92.0
PARAM_TEMPERATURE_TOLERANCE=2.0

# Hardware / Adapter Mode (simulated | real)
SENSOR_ADAPTER_MODE=simulated
ACTUATOR_ADAPTER_MODE=simulated

# MQTT Broker (Future Integration)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=batchsaver-core
MQTT_TOPIC_PREFIX=batchsaver/factory01/line01

# OPC-UA Server (Future Integration)
OPCUA_ENDPOINT_URL=opc.tcp://localhost:4840/BatchSaverServer
OPCUA_SECURITY_POLICY=Basic256Sha256

# Modbus TCP (Future Integration)
MODBUS_HOST=localhost
MODBUS_PORT=502
MODBUS_UNIT_ID=1

# Real-time WebSocket / SSE
WS_PATH=/ws
SSE_HEARTBEAT_INTERVAL_MS=5000
